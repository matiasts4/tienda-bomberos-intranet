# Variables que lee docker-compose.yml al levantar el stack.
#
#   cp .env.example .env && docker compose up -d --build
#
# Este archivo NO reemplaza a backend/.env ni a frontend/.env: cada aplicación
# tiene el suyo. Aquí solo van los valores que Compose necesita para armar los
# contenedores y publicar los puertos.
# Todas las claves tienen un valor por defecto en el compose, así que un .env
# vacío también funciona; esto sirve para cambiarlos sin editar el YAML.

# --- Puertos publicados en el host ---
# Cámbialos si ya tienes algo escuchando en 3000 / 8000 / 3307.
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT_HOST=3307

# --- Base de datos ---
# Credenciales del entorno local únicamente. Deben coincidir con las de
# backend/.env, porque el contenedor de MariaDB crea la base con estos valores.
DB_DATABASE=tienda_bomberos
DB_USERNAME=root
DB_PASSWORD=secret

# --- URL de la API para el frontend ---
# La resuelve el navegador del usuario, no el contenedor del frontend: por eso
# es localhost y el puerto publicado del backend, no http://backend:8000.
# Debe apuntar al mismo valor de BACKEND_PORT.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Permisos del bind mount del backend ---
# El contenedor del backend corre como usuario no-root. Si tu UID/GID no son
# estos, Laravel escribirá storage/ y bootstrap/cache/ con otro dueño.
# Averígualos con:  id -u  /  id -g
UID=501
GID=20
